{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            c.id as cart_item_id,\n            c.product_id,\n            c.quantity,\n            p.name as product_name,\n            p.image_url,\n            p.price\n        FROM cart_items c\n        JOIN products p ON c.product_id = p.id\n        WHERE c.user_id = $1\n        ORDER BY c.created_at DESC\n        ",
