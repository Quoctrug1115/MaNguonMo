  "query": "\n        SELECT w.product_id, p.name as product_name, p.price::float8, p.image_url \n        FROM wishlist_items w\n        JOIN products p ON w.product_id = p.id\n        WHERE w.user_id = $1\n        ORDER BY w.created_at DESC\n        ",
