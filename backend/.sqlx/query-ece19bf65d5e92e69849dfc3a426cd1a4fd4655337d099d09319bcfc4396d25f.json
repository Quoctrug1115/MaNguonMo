  "query": "\n            SELECT oi.quantity, oi.price_at_purchase::float8 as price, p.name as product_name, p.image_url \n            FROM order_items oi\n            JOIN products p ON oi.product_id = p.id\n            WHERE oi.order_id = $1\n            ",
